# 绘图：核心是 fill = Group，这会自动生成填色方块图例
p <- ggplot(data, aes(x = Category, y = Value, fill = Group)) +
geom_col(position = "dodge") +                     # 并排柱状图
labs(
title = "各组测量值对比",
x = "分组类别",
y = "测量数值",
fill = "实验分组"                                 # 修改图例标题就在这里
) +
theme_minimal(base_family = "myfont") +            # 应用中文字体
theme(
plot.title = element_text(hjust = 0.5)
)
