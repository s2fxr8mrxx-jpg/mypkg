file_lc<-"D:/共进化/data/Gene.csv"
df=read_csv(file_lc,col_names=TRUE)
df<-df%>%column_to_rownames('RNA')
df<-as.data.frame(df)
justify_vector<-as.data.frame(t((df!=0)*1))
averages<-rowSums(justify_vector)/length(colnames(justify_vector))
justify_vector$average<-averages
means<-mean(averages)
vars<-var(averages)
justify_vector$sum<-rowSums(justify_vector)
q1<-quantile(justify_vector$sum,0.25)
