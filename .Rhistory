# 加载 ggplot2
library(ggplot2)
# 创建数据
data <- data.frame(
category = c("满意", "不满意"),
count = c(126, 0)
)
# 计算百分比标签（保留一位小数）
data$fraction <- data$count / sum(data$count)
data$label <- paste0(data$category, "\n", data$count, " (",
round(data$fraction * 100, 1), "%)")
# 绘制饼图
ggplot(data, aes(x = "", y = count, fill = category)) +
geom_col(width = 1, color = "white") +          # 白色边框分隔扇区
coord_polar("y", start = 0) +                   # 转为极坐标
geom_text(aes(label = label),
position = position_stack(vjust = 0.5), # 标签置于扇区中部
size = 5) +
scale_fill_manual(values = c("满意" = "#4CAF50",  # 自定义颜色
"不满意" = "#F44336")) +
theme_void() +                                   # 去掉坐标轴和背景
labs(title = "满意度调查结果") +
theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
legend.position = "none")                  # 隐藏图例（标签已说明）
