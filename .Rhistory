)+
new_scale_fill()+scale_fill_manual(values=tissue_colors)+
geom_rect(
aes(
xmin = xmin - 0.5,
xmax = xmax + 0.5,
ymin = y - height/2,
ymax = y + height/2,
fill = Tissue
),
data = df_trtile(df_final, c("Species",'Logogram','Tissue'), 1.03*y_max),
inherit.aes = FALSE
)+
new_scale_fill()+scale_fill_manual(values=nucleic_colors)+
geom_rect(
aes(
ymin = ymin - 0.5,
ymax = ymax + 0.5,
xmin = x - width/2,
xmax = x + width/2,
fill = Virus_type
),
data = df_trtile_y(df_final, c("Nucleic"), 1.035*x_max),
inherit.aes = FALSE
)+
theme(axis.text.x = element_text(size = 7,angle  =60,vjust = 0.5),
axis.text.y = element_text(size = 6),
axis.ticks = element_blank(),
axis.title.x = element_blank(),
axis.title.y = element_blank(),
legend.background = element_rect(fill = "white", colour = NA),
legend.key = element_rect(fill = "white", colour = NA))+
guides(size=guide_legend(labels=c('20%',"40","60","80","100")))
ggsave("D:/共进化/FigureA.pdf",width = 20,height = 15,limitsize = FALSE)
